# Copy this file to .env.local for local development (never commit .env* files).
# All variables here are prefixed VITE_ and are bundled into the client-side
# JavaScript, so nothing secret can live in this file — Vite exposes every
# VITE_-prefixed variable to the browser. If a future feature needs a real
# secret (an API key, a signed gateway token, etc.), it belongs in a Netlify
# Function's environment variables (set in the Netlify dashboard), never here.

# Set to "false" once a real ESP32 gateway is implemented and tested.
# Defaults to "true" (mock mode) when unset.
VITE_ROBOT_MOCK_MODE=true

# Base URL of a future secure gateway that relays commands to the ESP32.
# Leave empty to stay in mock mode regardless of VITE_ROBOT_MOCK_MODE.
VITE_ROBOT_API_BASE_URL=
